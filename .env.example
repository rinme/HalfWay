# ==============================================================================
# HalfWay Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development, or configure in Vercel.
# All environment variables are optional. HalfWay functions completely out-of-the-box
# using OpenStreetMap / Overpass API without requiring any external API keys or services.

# ------------------------------------------------------------------------------
# Google Maps Platform (Optional)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY:
# - Optional default API key for both client and server.
# - When set, the client automatically defaults to Google Maps provider,
#   loads the Google Maps JavaScript SDK, and displays the "Server Default Key" badge.
# - Also used by server API routes (/api/search-midpoint, /api/geocode, /api/reverse-geocode)
#   for Google Places and Geocoding APIs when no user-provided key is stored.
# - Requires Maps JavaScript API, Places API, and Geocoding API enabled in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# GOOGLE_MAPS_API_KEY:
# - Optional server-only fallback key for backend Google Places and Geocoding requests.
# - Ignored by the client bundle to prevent exposing private server keys.
# - Used by server API routes if NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is not set.
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# Upstash Redis (Optional - Serverless Persistent Share Store)
# ------------------------------------------------------------------------------
# In serverless environments like Vercel, in-memory share records do not persist
# across cold starts or isolated lambda instances. Configure Upstash Redis REST
# credentials to persist share codes (?s=...) globally with automatic TTL expiration.
# If omitted, HalfWay falls back to a robust in-memory LRU store automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
